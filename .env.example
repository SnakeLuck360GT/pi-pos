# Set in Netlify: Site configuration > Environment variables

# Password for /admin. Also typed once on each tablet to connect it.
ADMIN_PASSWORD=change-me

# Optional. The Pi's key. Generated and stored automatically if you leave it out.
PRINTER_KEY=

# Optional. Signs logins; changing it signs everyone out.
SESSION_SECRET=

# Optional. Repo the Pi installer clones, if you run a fork.
PIPOS_REPO=https://github.com/SnakeLuck360GT/pi-pos
