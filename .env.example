# Set these in Netlify: Site configuration > Environment variables

# Password for the admin panel (/admin), also used to connect a POS tablet.
ADMIN_PASSWORD=change-me

# Shared key the Raspberry Pi sends to fetch print jobs. Generate one: openssl rand -hex 24
PRINTER_KEY=

# Optional. Signs login tokens; defaults to a value derived from ADMIN_PASSWORD.
# Changing it (or the password) signs out every admin and tablet.
SESSION_SECRET=
