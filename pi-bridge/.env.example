# Your PiPOS site, no slash at the end
API_BASE=https://your-shop.netlify.app
# Admin -> Printer shows both of these
PRINTER_KEY=
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# USB: /dev/usb/lp0. Network printer: tcp://192.168.1.50:9100
PRINTER=/dev/usb/lp0
# Leave empty to use the encoding set in Admin -> Printer. gb2312 for cheap printers that print Chinese as garbage.
ENCODING=
# partial, full or none
CUT=partial
# Safety-net poll in ms if a push is missed. 0 turns it off.
FALLBACK_POLL_MS=300000
